    %vpi_call/w 3 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x6212289da950 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x6212289da950;
T_1 ;
    %vpi_call/w 3 17 "$monitor", "T=%0t|a=%b;b=%b|A=%b;B=%b;C=%b;D=%b", $time, v0x6212289ef700_0, v0x6212289ef7f0_0, v0x6212289ef3a0_0, v0x6212289ef460_0, v0x6212289ef530_0, v0x6212289ef630_0 {0 0 0};
