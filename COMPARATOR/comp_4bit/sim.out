#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5dfc3a741be0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5dfc3a741d70 .scope module, "comparator_4bit_tb" "comparator_4bit_tb" 3 1;
 .timescale 0 0;
v0x5dfc3a753bf0_0 .var "a", 3 0;
v0x5dfc3a753ce0_0 .var "b", 3 0;
v0x5dfc3a753db0_0 .net "y", 0 0, L_0x5dfc3a753eb0;  1 drivers
S_0x5dfc3a708500 .scope module, "dut" "comparator_4bit" 3 5, 4 1 0, S_0x5dfc3a741d70;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /INPUT 4 "b";
    .port_info 2 /OUTPUT 1 "y";
v0x5dfc3a7086e0_0 .net "a", 3 0, v0x5dfc3a753bf0_0;  1 drivers
v0x5dfc3a7539f0_0 .net "b", 3 0, v0x5dfc3a753ce0_0;  1 drivers
v0x5dfc3a753ad0_0 .net "y", 0 0, L_0x5dfc3a753eb0;  alias, 1 drivers
L_0x5dfc3a753eb0 .cmp/eq 4, v0x5dfc3a753bf0_0, v0x5dfc3a753ce0_0;
    .scope S_0x5dfc3a741d70;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "comparator_4bit.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars" {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5dfc3a741d70;
T_1 ;
    %vpi_call/w 3 15 "$monitor", "a=%b  b=%b | y=%b", v0x5dfc3a753bf0_0, v0x5dfc3a753ce0_0, v0x5dfc3a753db0_0 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5dfc3a753bf0_0, 0, 4;
    %pushi/vec4 6, 0, 4;
    %store/vec4 v0x5dfc3a753ce0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x5dfc3a753bf0_0, 0, 4;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x5dfc3a753ce0_0, 0, 4;
    %delay 10, 0;
    %vpi_call/w 3 18 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "comp_tb.v";
    "comp.v";
