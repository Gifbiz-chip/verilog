#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5898c0f13a50 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5898c0f13be0 .scope module, "comp_1s_tb" "comp_1s_tb" 3 1;
 .timescale 0 0;
v0x5898c0f24dc0_0 .var "a", 3 0;
v0x5898c0f24e80_0 .net "y", 3 0, L_0x5898c0f24f50;  1 drivers
S_0x5898c0eda500 .scope module, "dut" "comp_1s" 3 4, 4 1 0, S_0x5898c0f13be0;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /OUTPUT 4 "y";
L_0x5898c0f24f50 .functor NOT 4, v0x5898c0f24dc0_0, C4<0000>, C4<0000>, C4<0000>;
v0x5898c0eda6e0_0 .net "a", 3 0, v0x5898c0f24dc0_0;  1 drivers
v0x5898c0f24c80_0 .net "y", 3 0, L_0x5898c0f24f50;  alias, 1 drivers
    .scope S_0x5898c0f13be0;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "complement_1s.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars" {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5898c0f13be0;
T_1 ;
    %vpi_call/w 3 13 "$monitor", "a=%b | y=%b", v0x5898c0f24dc0_0, v0x5898c0f24e80_0 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5898c0f24dc0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x5898c0f24dc0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x5898c0f24dc0_0, 0, 4;
    %delay 10, 0;
    %vpi_call/w 3 17 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "comp_tb.v";
    "comp.v";
