#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5b29b4a8bad0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5b29b4a8bc60 .scope module, "bcd_ex3_tb" "bcd_ex3_tb" 3 1;
 .timescale 0 0;
v0x5b29b4a9fee0_0 .var "BCD", 3 0;
v0x5b29b4a9ffd0_0 .net "e", 3 0, L_0x5b29b4aa00d0;  1 drivers
S_0x5b29b4a52500 .scope module, "dut" "bcd_ex3" 3 4, 4 1 0, S_0x5b29b4a8bc60;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "BCD";
    .port_info 1 /OUTPUT 4 "e";
v0x5b29b4a526e0_0 .net "BCD", 3 0, v0x5b29b4a9fee0_0;  1 drivers
L_0x74029c528018 .functor BUFT 1, C4<0011>, C4<0>, C4<0>, C4<0>;
v0x5b29b4a9fce0_0 .net/2u *"_ivl_0", 3 0, L_0x74029c528018;  1 drivers
v0x5b29b4a9fdc0_0 .net "e", 3 0, L_0x5b29b4aa00d0;  alias, 1 drivers
L_0x5b29b4aa00d0 .arith/sum 4, v0x5b29b4a9fee0_0, L_0x74029c528018;
    .scope S_0x5b29b4a8bc60;
T_0 ;
    %vpi_call/w 3 6 "$dumpfile", "bcd_ex3.vcd" {0 0 0};
    %vpi_call/w 3 7 "$dumpvars" {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5b29b4a8bc60;
T_1 ;
    %vpi_call/w 3 10 "$monitor", "time=%0t | BCD=%b e=%b ", $time, v0x5b29b4a9ffd0_0, v0x5b29b4a9fee0_0 {0 0 0};
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x5b29b4a9fee0_0, 0, 4;
    %delay 1, 0;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x5b29b4a9fee0_0, 0, 4;
    %delay 1, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x5b29b4a9fee0_0, 0, 4;
    %delay 1, 0;
    %pushi/vec4 6, 0, 4;
    %store/vec4 v0x5b29b4a9fee0_0, 0, 4;
    %delay 1, 0;
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x5b29b4a9fee0_0, 0, 4;
    %delay 1, 0;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x5b29b4a9fee0_0, 0, 4;
    %delay 1, 0;
    %pushi/vec4 9, 0, 4;
    %store/vec4 v0x5b29b4a9fee0_0, 0, 4;
    %delay 1, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5b29b4a9fee0_0, 0, 4;
    %delay 1, 0;
    %pushi/vec4 11, 0, 4;
    %store/vec4 v0x5b29b4a9fee0_0, 0, 4;
    %delay 1, 0;
    %pushi/vec4 12, 0, 4;
    %store/vec4 v0x5b29b4a9fee0_0, 0, 4;
    %delay 1, 0;
    %vpi_call/w 3 21 "$finish" {0 0 0};
    %end;
    .thread T_1;
