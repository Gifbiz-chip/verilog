S_0x5b0f09dc1eb0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5b0f09dc2040 .scope module, "demux_1to2_tb" "demux_1to2_tb" 3 1;
 .timescale 0 0;
v0x5b0f09dd5850_0 .var "D", 0 0;
v0x5b0f09dd5910_0 .var "S", 0 0;
v0x5b0f09dd59e0_0 .net "y0", 0 0, L_0x5b0f09dd5ca0;  1 drivers
v0x5b0f09dd5ae0_0 .net "y1", 0 0, L_0x5b0f09dd5e00;  1 drivers
S_0x5b0f09d88500 .scope module, "dut" "demux_1to2" 3 4, 4 1 0, S_0x5b0f09dc2040;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "D";
    .port_info 1 /INPUT 1 "S";
    .port_info 2 /OUTPUT 1 "y0";
    .port_info 3 /OUTPUT 1 "y1";
L_0x5b0f09dd5bb0 .functor NOT 1, v0x5b0f09dd5910_0, C4<0>, C4<0>, C4<0>;
L_0x5b0f09dd5ca0 .functor AND 1, v0x5b0f09dd5850_0, L_0x5b0f09dd5bb0, C4<1>, C4<1>;
L_0x5b0f09dd5e00 .functor AND 1, v0x5b0f09dd5850_0, v0x5b0f09dd5910_0, C4<1>, C4<1>;
v0x5b0f09d88750_0 .net "D", 0 0, v0x5b0f09dd5850_0;  1 drivers
v0x5b0f09dd5480_0 .net "S", 0 0, v0x5b0f09dd5910_0;  1 drivers
v0x5b0f09dd5540_0 .net *"_ivl_0", 0 0, L_0x5b0f09dd5bb0;  1 drivers
v0x5b0f09dd5600_0 .net "y0", 0 0, L_0x5b0f09dd5ca0;  alias, 1 drivers
v0x5b0f09dd56c0_0 .net "y1", 0 0, L_0x5b0f09dd5e00;  alias, 1 drivers
    .scope S_0x5b0f09dc2040;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "demux_1to2.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5b0f09dc2040 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5b0f09dc2040;
T_1 ;
    %vpi_call/w 3 15 "$monitor", "D=%b;S=%b|y0=%b;y1=%b", v0x5b0f09dd5850_0, v0x5b0f09dd5910_0, v0x5b0f09dd59e0_0, v0x5b0f09dd5ae0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5b0f09dd5910_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b0f09dd5850_0, 0, 1;
    %delay 3, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5b0f09dd5910_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5b0f09dd5850_0, 0, 1;
    %delay 3, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b0f09dd5910_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5b0f09dd5850_0, 0, 1;
    %delay 3, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b0f09dd5910_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b0f09dd5850_0, 0, 1;
    %delay 3, 0;
    %vpi_call/w 3 20 "$finish" {0 0 0};
    %end;
    .thread T_1;
