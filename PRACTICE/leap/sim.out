#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x627d98a56a40 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x627d98a56bd0 .scope module, "leap_tb" "leap_tb" 3 1;
 .timescale 0 0;
v0x627d98a690c0_0 .net "leap", 0 0, v0x627d98a1c6e0_0;  1 drivers
v0x627d98a69160_0 .var "year", 15 0;
S_0x627d98a1c500 .scope module, "dut" "leap" 3 4, 4 1 0, S_0x627d98a56bd0;
 .timescale 0 0;
    .port_info 0 /INPUT 16 "year";
    .port_info 1 /OUTPUT 1 "leap";
v0x627d98a1c6e0_0 .var "leap", 0 0;
v0x627d98a68f80_0 .net "year", 15 0, v0x627d98a69160_0;  1 drivers
E_0x627d98a57110 .event anyedge, v0x627d98a68f80_0;
    .scope S_0x627d98a1c500;
T_0 ;
    %wait E_0x627d98a57110;
    %load/vec4 v0x627d98a68f80_0;
    %pad/u 32;
    %pushi/vec4 400, 0, 32;
    %mod;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_0.0, 4;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x627d98a1c6e0_0, 0, 1;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x627d98a68f80_0;
    %pad/u 32;
    %pushi/vec4 100, 0, 32;
    %mod;
    %pushi/vec4 0, 0, 32;
    %cmp/e;
    %flag_get/vec4 4;
    %load/vec4 v0x627d98a68f80_0;
    %pad/u 32;
    %pushi/vec4 4, 0, 32;
    %mod;
    %pushi/vec4 0, 0, 32;
    %cmp/e;
    %flag_get/vec4 4;
    %and;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x627d98a1c6e0_0, 0, 1;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x627d98a68f80_0;
    %pad/u 32;
    %pushi/vec4 4, 0, 32;
    %mod;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_0.4, 4;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x627d98a1c6e0_0, 0, 1;
    %jmp T_0.5;
T_0.4 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x627d98a1c6e0_0, 0, 1;
T_0.5 ;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x627d98a56bd0;
T_1 ;
    %vpi_call/w 3 9 "$monitor", "year =%d | leap =%b", v0x627d98a69160_0, v0x627d98a690c0_0 {0 0 0};
    %pushi/vec4 2000, 0, 16;
    %store/vec4 v0x627d98a69160_0, 0, 16;
    %delay 10, 0;
    %pushi/vec4 1974, 0, 16;
    %store/vec4 v0x627d98a69160_0, 0, 16;
    %delay 10, 0;
    %pushi/vec4 2024, 0, 16;
    %store/vec4 v0x627d98a69160_0, 0, 16;
    %delay 10, 0;
    %pushi/vec4 1996, 0, 16;
    %store/vec4 v0x627d98a69160_0, 0, 16;
    %delay 10, 0;
    %pushi/vec4 2026, 0, 16;
    %store/vec4 v0x627d98a69160_0, 0, 16;
    %delay 10, 0;
    %pushi/vec4 2001, 0, 16;
    %store/vec4 v0x627d98a69160_0, 0, 16;
    %delay 10, 0;
    %vpi_call/w 3 16 "$finish" {0 0 0};
    %end;
    .thread T_1;
