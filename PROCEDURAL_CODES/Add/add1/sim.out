#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x61a8bacf25d0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x61a8bacf2760 .scope module, "add" "add" 3 1;
 .timescale 0 0;
v0x61a8bad18a60_0 .var "a", 3 0;
v0x61a8bad3a030_0 .var "b", 3 0;
E_0x61a8bacf2c50 .event anyedge, v0x61a8bad18a60_0, v0x61a8bad3a030_0;
    .scope S_0x61a8bacf2760;
T_0 ;
    %wait E_0x61a8bacf2c50;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x61a8bad18a60_0, 0, 4;
    %load/vec4 v0x61a8bad18a60_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x61a8bad3a030_0, 0;
    %delay 1, 0;
    %vpi_call/w 3 7 "$display", "a=%0d b=%0d", v0x61a8bad18a60_0, v0x61a8bad3a030_0 {0 0 0};
    %jmp T_0;
    .thread T_0, $push;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "add.v";
