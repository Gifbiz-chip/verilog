#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5854a5f3a600 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5854a5f3a7b0 .scope module, "ha_nonblocking" "ha_nonblocking" 3 1;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "a";
    .port_info 2 /INPUT 1 "b";
    .port_info 3 /OUTPUT 1 "sum";
    .port_info 4 /OUTPUT 1 "carry";
o0x7c85606a9018 .functor BUFZ 1, C4<z>; HiZ drive
v0x5854a5f60760_0 .net "a", 0 0, o0x7c85606a9018;  0 drivers
o0x7c85606a9048 .functor BUFZ 1, C4<z>; HiZ drive
v0x5854a5f82390_0 .net "b", 0 0, o0x7c85606a9048;  0 drivers
v0x5854a5f82450_0 .var "carry", 0 0;
o0x7c85606a90a8 .functor BUFZ 1, C4<z>; HiZ drive
v0x5854a5f82520_0 .net "clk", 0 0, o0x7c85606a90a8;  0 drivers
v0x5854a5f825e0_0 .var "sum", 0 0;
E_0x5854a5f3ae20 .event posedge, v0x5854a5f82520_0;
    .scope S_0x5854a5f3a7b0;
T_0 ;
    %wait E_0x5854a5f3ae20;
    %load/vec4 v0x5854a5f60760_0;
    %load/vec4 v0x5854a5f82390_0;
    %xor;
    %assign/vec4 v0x5854a5f825e0_0, 0;
    %load/vec4 v0x5854a5f60760_0;
    %load/vec4 v0x5854a5f82390_0;
    %and;
    %assign/vec4 v0x5854a5f82450_0, 0;
    %jmp T_0;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
