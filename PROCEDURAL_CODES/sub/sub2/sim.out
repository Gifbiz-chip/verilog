#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x60ae0a7e5600 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x60ae0a7e57b0 .scope module, "blocking_sub" "blocking_sub" 3 1;
 .timescale 0 0;
v0x60ae0a80b940_0 .var "a", 3 0;
v0x60ae0a82d4a0_0 .var "b", 3 0;
v0x60ae0a82d580_0 .var "y", 4 0;
    .scope S_0x60ae0a7e57b0;
T_0 ;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x60ae0a80b940_0, 0, 4;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x60ae0a82d4a0_0, 0, 4;
    %load/vec4 v0x60ae0a80b940_0;
    %pad/u 5;
    %load/vec4 v0x60ae0a82d4a0_0;
    %pad/u 5;
    %sub;
    %store/vec4 v0x60ae0a82d580_0, 0, 5;
    %vpi_call/w 3 8 "$display", "a=%d, b=%d | y=%d", v0x60ae0a80b940_0, v0x60ae0a82d4a0_0, v0x60ae0a82d580_0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "sub.v";
