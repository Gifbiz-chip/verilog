#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5b12857ad630 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5b12857ad7e0 .scope module, "blocking_swap" "blocking_swap" 3 1;
 .timescale 0 0;
v0x5b12857d3580_0 .var "a", 0 0;
v0x5b12857f50e0_0 .var "b", 0 0;
v0x5b12857f51a0_0 .var "c", 0 0;
    .scope S_0x5b12857ad7e0;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5b12857d3580_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b12857f50e0_0, 0, 1;
    %load/vec4 v0x5b12857d3580_0;
    %store/vec4 v0x5b12857f51a0_0, 0, 1;
    %load/vec4 v0x5b12857f50e0_0;
    %store/vec4 v0x5b12857d3580_0, 0, 1;
    %load/vec4 v0x5b12857f51a0_0;
    %store/vec4 v0x5b12857f50e0_0, 0, 1;
    %vpi_call/w 3 9 "$display", "a=%d, b=%d", v0x5b12857d3580_0, v0x5b12857f50e0_0 {0 0 0};
    %vpi_call/w 3 10 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "swap.v";
