#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x603d5f936620 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x603d5f9367d0 .scope module, "up_counter" "up_counter" 3 1;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 1 "up";
    .port_info 3 /OUTPUT 4 "count";
o0x789ff2a4b018 .functor BUFZ 1, C4<z>; HiZ drive
v0x603d5f95c6f0_0 .net "clk", 0 0, o0x789ff2a4b018;  0 drivers
v0x603d5f97e260_0 .var "count", 3 0;
o0x789ff2a4b078 .functor BUFZ 1, C4<z>; HiZ drive
v0x603d5f97e340_0 .net "rst", 0 0, o0x789ff2a4b078;  0 drivers
o0x789ff2a4b0a8 .functor BUFZ 1, C4<z>; HiZ drive
v0x603d5f97e410_0 .net "up", 0 0, o0x789ff2a4b0a8;  0 drivers
E_0x603d5f96f8e0 .event posedge, v0x603d5f95c6f0_0;
    .scope S_0x603d5f9367d0;
T_0 ;
    %wait E_0x603d5f96f8e0;
    %load/vec4 v0x603d5f97e340_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x603d5f97e260_0, 0, 4;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x603d5f97e260_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x603d5f97e260_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "up.v";
