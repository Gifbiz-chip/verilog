#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5804a6ce3f20 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5804a6ce40b0 .scope module, "counter_tb" "counter_tb" 3 1;
 .timescale 0 0;
v0x5804a6cf6410_0 .var "clk", 0 0;
v0x5804a6cf64e0_0 .net "count", 1 0, v0x5804a6cf6210_0;  1 drivers
v0x5804a6cf65b0_0 .var "rst", 0 0;
S_0x5804a6caa500 .scope module, "dut" "counter" 3 4, 4 1 0, S_0x5804a6ce40b0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 2 "count";
v0x5804a6caa730_0 .net "clk", 0 0, v0x5804a6cf6410_0;  1 drivers
v0x5804a6cf6210_0 .var "count", 1 0;
v0x5804a6cf62f0_0 .net "rst", 0 0, v0x5804a6cf65b0_0;  1 drivers
E_0x5804a6ce48f0 .event posedge, v0x5804a6caa730_0;
    .scope S_0x5804a6caa500;
T_0 ;
    %wait E_0x5804a6ce48f0;
    %load/vec4 v0x5804a6cf62f0_0;
    %pad/u 32;
    %cmpi/e 1, 0, 32;
    %jmp/0xz  T_0.0, 4;
    %pushi/vec4 0, 0, 2;
    %assign/vec4 v0x5804a6cf6210_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5804a6cf6210_0;
    %addi 1, 0, 2;
    %assign/vec4 v0x5804a6cf6210_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5804a6ce40b0;
T_1 ;
    %vpi_call/w 3 10 "$dumpfile", "counter.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x5804a6ce40b0;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5804a6cf6410_0, 0, 1;
    %end;
    .thread T_2;
    .scope S_0x5804a6ce40b0;
T_3 ;
    %delay 4, 0;
    %load/vec4 v0x5804a6cf6410_0;
    %inv;
    %store/vec4 v0x5804a6cf6410_0, 0, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0x5804a6ce40b0;
T_4 ;
    %vpi_call/w 3 16 "$monitor", "clk=%b  rst=%b|count=%b", v0x5804a6cf6410_0, v0x5804a6cf65b0_0, v0x5804a6cf64e0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5804a6cf65b0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5804a6cf65b0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 19 "$finish" {0 0 0};
    %end;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "count_tb.v";
    "count.v";
