v0x607d62f74220_0 .net "d", 0 0, o0x7a02c1b9f018;  0 drivers
o0x7a02c1b9f048 .functor BUFZ 1, C4<z>; HiZ drive
v0x607d62f953f0_0 .net "en", 0 0, o0x7a02c1b9f048;  0 drivers
v0x607d62f954b0_0 .var "q", 0 0;
E_0x607d62f4eba0 .event anyedge, v0x607d62f953f0_0, v0x607d62f74220_0;
    .scope S_0x607d62f4e790;
T_0 ;
    %wait E_0x607d62f4eba0;
    %load/vec4 v0x607d62f953f0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x607d62f74220_0;
    %store/vec4 v0x607d62f954b0_0, 0, 1;
T_0.0 ;
