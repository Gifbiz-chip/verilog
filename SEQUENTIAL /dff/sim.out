#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x64f9045e6d20 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x64f9045e6eb0 .scope module, "d_flipflop_tb" "d_flipflop_tb" 3 1;
 .timescale 0 0;
v0x64f9045f8e40_0 .var "a", 0 0;
v0x64f9045f8f10_0 .var "clk", 0 0;
v0x64f9045f8fe0_0 .net "y", 0 0, v0x64f9045f8d20_0;  1 drivers
S_0x64f9045ad500 .scope module, "dut" "d_flipflop" 3 4, 4 1 0, S_0x64f9045e6eb0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "a";
    .port_info 2 /OUTPUT 1 "y";
v0x64f9045ad730_0 .net "a", 0 0, v0x64f9045f8e40_0;  1 drivers
v0x64f9045f8c60_0 .net "clk", 0 0, v0x64f9045f8f10_0;  1 drivers
v0x64f9045f8d20_0 .var "y", 0 0;
E_0x64f9045e72c0 .event negedge, v0x64f9045f8c60_0;
E_0x64f9045e7af0 .event posedge, v0x64f9045f8c60_0;
    .scope S_0x64f9045ad500;
T_0 ;
    %wait E_0x64f9045e7af0;
    %load/vec4 v0x64f9045ad730_0;
    %assign/vec4 v0x64f9045f8d20_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_0x64f9045ad500;
T_1 ;
    %wait E_0x64f9045e72c0;
    %load/vec4 v0x64f9045ad730_0;
    %assign/vec4 v0x64f9045f8d20_0, 0;
    %jmp T_1;
    .thread T_1;
    .scope S_0x64f9045e6eb0;
T_2 ;
    %vpi_call/w 3 10 "$dumpfile", "d_flipflop.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x64f9045e6eb0 {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x64f9045e6eb0;
T_3 ;
    %vpi_call/w 3 14 "$monitor", "clk=%b, a=%b | y=%b", v0x64f9045f8f10_0, v0x64f9045f8e40_0, v0x64f9045f8fe0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x64f9045f8f10_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x64f9045f8e40_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x64f9045f8f10_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x64f9045f8e40_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 17 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "dff_tb.v";
    "dff.v";
