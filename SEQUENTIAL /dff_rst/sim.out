#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5d4fcd83f0f0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5d4fcd83f280 .scope module, "dff_sync_rst_tb" "dff_sync_rst_tb" 3 1;
 .timescale 0 0;
v0x5d4fcd852790_0 .var "clk", 0 0;
v0x5d4fcd852850_0 .var "d", 0 0;
v0x5d4fcd852920_0 .var "rst", 0 0;
v0x5d4fcd852a20_0 .net "y", 0 0, v0x5d4fcd852620_0;  1 drivers
S_0x5d4fcd805500 .scope module, "dut" "dff_sync_rst" 3 4, 4 1 0, S_0x5d4fcd83f280;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 1 "d";
    .port_info 3 /OUTPUT 1 "y";
v0x5d4fcd805750_0 .net "clk", 0 0, v0x5d4fcd852790_0;  1 drivers
v0x5d4fcd852490_0 .net "d", 0 0, v0x5d4fcd852850_0;  1 drivers
v0x5d4fcd852550_0 .net "rst", 0 0, v0x5d4fcd852920_0;  1 drivers
v0x5d4fcd852620_0 .var "y", 0 0;
E_0x5d4fcd83fbd0 .event posedge, v0x5d4fcd805750_0;
    .scope S_0x5d4fcd805500;
T_0 ;
    %wait E_0x5d4fcd83fbd0;
    %load/vec4 v0x5d4fcd852550_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x5d4fcd852620_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5d4fcd852490_0;
    %assign/vec4 v0x5d4fcd852620_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5d4fcd83f280;
T_1 ;
    %vpi_call/w 3 11 "$dumpfile", "dff_sync_rst.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x5d4fcd83f280;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5d4fcd852790_0, 0, 1;
    %end;
    .thread T_2;
    .scope S_0x5d4fcd83f280;
T_3 ;
    %delay 2, 0;
    %load/vec4 v0x5d4fcd852790_0;
    %inv;
    %store/vec4 v0x5d4fcd852790_0, 0, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0x5d4fcd83f280;
T_4 ;
    %vpi_call/w 3 17 "$monitor", "clk=%b rst=%b d=%b |y=%b", v0x5d4fcd852790_0, v0x5d4fcd852920_0, v0x5d4fcd852850_0, v0x5d4fcd852a20_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5d4fcd852920_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5d4fcd852850_0, 0, 1;
    %delay 3, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5d4fcd852920_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5d4fcd852850_0, 0, 1;
    %delay 3, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5d4fcd852920_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5d4fcd852850_0, 0, 1;
    %delay 3, 0;
    %vpi_call/w 3 21 "$finish" {0 0 0};
    %end;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "dff_tb.v";
    "dff.v";
