T_1 ;
    %vpi_call/w 3 15 "$monitor", "a=%b,b=%b|sum=%b,carry=%b", v0x64bebb95af50_0, v0x64bebb95b010_0, v0x64bebb95b1e0_0, v0x64bebb95b0e0_0 {0 0 0};
